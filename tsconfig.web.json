{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "web/tests/**/*.ts",
    "web/tests/**/*.tsx",
    "vite.config.ts"
  ]
}
