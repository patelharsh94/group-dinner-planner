{
  "name": "group-dinner-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --exclude 'tests/persistence/**' --exclude 'tests/live/**' && npm run test:web",
    "test:db": "vitest run tests/persistence",
    "test:live": "tsx scripts/live-check.ts",
    "eval:muse": "tsx scripts/evaluate-muse.ts",
    "db:migrate": "tsx src/persistence/migrate.ts",
    "telegram:register": "tsx scripts/register-webhook.ts",
    "test:db:embedded": "tsx scripts/test-postgres.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev:web": "vite",
    "test:browser": "playwright test --config web/playwright.config.ts",
    "test:web": "vitest run --config web/vitest.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "fastify": "^5.6.1",
    "grammy": "^1.38.3",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
